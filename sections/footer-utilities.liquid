<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  {{ section.shopify_attributes }}
>
  <div
    class="utilities spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;"
    data-testid="footer-utilities"
  >

    <div class="footer-column">
      <h4>Institucional</h4>
      <a href="/pages/colaboradores">Colaboradores</a>
      <a href="{{ routes.all_products_collection_url }}">Participe</a>
    </div>

    <div class="footer-column">
      {% content_for 'blocks' %}
    </div>

    <div class="footer-extra">
      <p class="footer-title">
        Compartilhe sua história #Oimpossiveleprovisorio <br>
        O que é o impossível provisório para você?
      </p>

      <p class="footer-contact">
        Contatos: <a href="mailto:falecom@desvelandooris.com">falecom@desvelandooris.com</a> <br>
        @desvelandooris @oimpossiveleprovisorio
      </p>
    </div>
  </div>
</div>

{% stylesheet %}
.utilities {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32px;
  border-top: var(--border-width) solid var(--color-border);
  padding-top: 20px;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-column h4 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--color-foreground);
}

.footer-column a {
  font-size: 13px;
  text-decoration: none;
  color: var(--color-foreground-muted);
  transition: all 0.2s ease;
}

.footer-column a:hover {
  color: var(--color-foreground);
  transform: translateX(2px);
}

@media screen and (min-width: 750px) {
  .utilities {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: start;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer profissional",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Largura",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "Espessura da linha",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Cores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Topo",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Base",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    { "type": "footer-copyright" },
    { "type": "footer-policy-list" }
  ],
  "presets": [
    {
      "name": "Footer profissional",
      "category": "Footer",
      "blocks": {
        "copyright": { "type": "footer-copyright" },
        "policy_list": { "type": "footer-policy-list" }
      },
      "block_order": ["policy_list", "copyright"]
    }
  ]
}
{% endschema %}